# --- LLM (BYOK: your keys, your bill. OpenRouter recommended: one key, every model)
OPENROUTER_API_KEY=
MARKETERLOOP_MODEL=openrouter/anthropic/claude-sonnet-4.5
# MARKETERLOOP_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Set to 1 to run the full pipeline with a deterministic local mock (no key, no cost).
# Used by CI and evals. Handy for trying the UI before you add a key.
MOCK_LLM=0

# --- Connectors (all optional; a connector with no key simply shows as not configured)
# Granola - meeting notes + transcripts. API keys need a Granola Business plan:
# Granola -> Settings -> Connectors -> API keys (keys start with grn_)
GRANOLA_API_KEY=
# GRANOLA_API_BASE=https://api.granola.ai

# Coming soon (stubs shipped so the pattern is visible - PRs welcome)
FIRECRAWL_API_KEY=
SPIDER_API_KEY=
BROWSERBASE_API_KEY=
EXA_API_KEY=

# --- Storage
MARKETERLOOP_DB=./data/marketerloop.db
